pipeline {
    agent any

    parameters {
        string(name: 'container', defaultValue: 'shs-target-app', description: 'Service to scale up')
    }

    stages {
        stage('Scale Service') {
            steps {
                echo "Scaling up service for: ${params.container}"
                sh "docker-compose up --scale target-app=2 -d"
            }
        }

        stage('Verify Recovery') {
            steps {
                sh """
                    sleep 5
                    docker ps --filter "name=${params.container}" --filter "status=running"
                """
            }
        }
    }

    post {
        success {
            echo "Scale-up succeeded"
        }
        failure {
            echo "Scale-up FAILED"
        }
    }
}